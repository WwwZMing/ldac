<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:LdacPanel"
        x:Class="LdacPanel.MainWindow"
        Title="LDAC A2DP"
        Width="940" Height="620" MinWidth="780" MinHeight="560"
        Background="#0E1116">

  <Grid RowDefinitions="Auto,*,Auto" Margin="20">

    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
      <Border x:Name="Dot" Width="10" Height="10" CornerRadius="5" Background="#5B6472" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Margin="12,0,0,0">
        <TextBlock Text="LDAC A2DP" Foreground="#E8ECF3" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock x:Name="Subtitle" Text="正在连接驱动…" Foreground="#8A94A6" FontSize="12" Margin="0,2,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
        <Button x:Name="LogBtn" Content="日志" Padding="12,6"/>
        <Border Background="#151A22" CornerRadius="8" Padding="14,7">
          <TextBlock x:Name="StateText" Text="IDLE" Foreground="#E8ECF3" FontSize="13" FontWeight="SemiBold"/>
        </Border>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,14,*" Margin="0,18,0,0">

      <Border Grid.Column="0" Background="#151A22" CornerRadius="12" Padding="18">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
          <TextBlock Text="链路" Foreground="#8A94A6" FontSize="12"/>
          <TextBlock x:Name="DeviceText" Grid.Row="1" Text="—" Foreground="#E8ECF3"
                     FontSize="15" TextWrapping="Wrap" Margin="0,10,0,0"/>

          <Grid Grid.Row="2" Margin="0,18,0,0" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="采样率" Foreground="#8A94A6" FontSize="13"/>
              <TextBlock x:Name="RateText" Grid.Column="1" Text="—" Foreground="#E8ECF3" FontSize="13" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
              <TextBlock Text="声道" Foreground="#8A94A6" FontSize="13"/>
              <TextBlock x:Name="ModeText" Grid.Column="1" Text="—" Foreground="#E8ECF3" FontSize="13" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
              <TextBlock Text="信令 MTU" Foreground="#8A94A6" FontSize="13"/>
              <TextBlock x:Name="SigMtuText" Grid.Column="1" Text="—" Foreground="#E8ECF3" FontSize="13" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Grid.Row="3" ColumnDefinitions="Auto,*">
              <TextBlock Text="媒体 MTU" Foreground="#8A94A6" FontSize="13"/>
              <TextBlock x:Name="MediaMtuText" Grid.Column="1" Text="—" Foreground="#E8ECF3" FontSize="13" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Grid.Row="4" ColumnDefinitions="Auto,*">
              <TextBlock Text="SEID" Foreground="#8A94A6" FontSize="13"/>
              <TextBlock x:Name="SeidText" Grid.Column="1" Text="—" Foreground="#E8ECF3" FontSize="13" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Grid.Row="5" ColumnDefinitions="Auto,*">
              <TextBlock Text="目标设备" Foreground="#8A94A6" FontSize="13"/>
              <TextBlock x:Name="TargetText" Grid.Column="1" Text="UGREEN-BT505" Foreground="#E8ECF3" FontSize="13" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Grid.Row="6" ColumnDefinitions="Auto,*">
              <TextBlock Text="发送端" Foreground="#8A94A6" FontSize="13"/>
              <TextBlock x:Name="SenderText" Grid.Column="1" Text="未运行" Foreground="#E8ECF3" FontSize="13" HorizontalAlignment="Right"/>
            </Grid>
          </Grid>

          <TextBlock Grid.Row="4" Text="发送端由后台服务托管 · 开机自启 · 关掉窗口不影响声音"
                     Foreground="#5B6472" FontSize="11" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <Grid Grid.Column="2" RowDefinitions="Auto,14,*">

        <Border Grid.Row="0" Background="#151A22" CornerRadius="12" Padding="18">
          <StackPanel Spacing="14">
            <TextBlock Text="编码" Foreground="#8A94A6" FontSize="12"/>
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="12">
              <TextBlock Text="协议" Foreground="#8A94A6" FontSize="13" VerticalAlignment="Center"/>
              <ComboBox x:Name="CodecBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0">
                <ComboBoxItem Content="LDAC"/>
                <!-- AAC：协商已通，编码器（MF AAC + LATM 封帧）在发送端，先只验协商 -->
                <ComboBoxItem Content="AAC"/>
              </ComboBox>
              <!-- 码率只对 LDAC 有意义（990/660/330 kbps 是 LDAC 的三档）。
                   AAC 是 AVDTP 里协商的固定 128 kbps CBR，没有"选码率"这回事，
                   所以选 AAC 时整行隐藏，换成一行说明。 -->
              <TextBlock x:Name="RateLabel" Grid.Row="1" Text="码率" Foreground="#8A94A6" FontSize="13" VerticalAlignment="Center"/>
              <StackPanel x:Name="RateRow" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="16">
                <RadioButton x:Name="Rate990" Content="990" GroupName="rate" IsChecked="True"/>
                <RadioButton x:Name="Rate660" Content="660" GroupName="rate"/>
                <RadioButton x:Name="Rate330" Content="330" GroupName="rate"/>
              </StackPanel>
              <TextBlock x:Name="AacInfo" Grid.Row="1" Grid.Column="1" Text="128 kbps CBR · 48 kHz 立体声（固定）"
                         Foreground="#5B6472" FontSize="12" VerticalAlignment="Center" IsVisible="False"/>
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#151A22" CornerRadius="12" Padding="18">
          <Grid RowDefinitions="Auto,Auto,*,Auto">
            <TextBlock Text="实时" Foreground="#8A94A6" FontSize="12"/>
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
              <TextBlock x:Name="PeakText" Text="peak —" Foreground="#E8ECF3" FontSize="13"/>
              <TextBlock x:Name="PpsText" Grid.Column="1" Text="— 包/秒" Foreground="#E8ECF3" FontSize="13"/>
            </Grid>
            <local:Sparkline x:Name="PeakChart" Grid.Row="2" Margin="0,12,0,0" MinHeight="70"/>
            <TextBlock x:Name="HintText" Grid.Row="3" Text="启动发送端后，这里显示 peak 曲线与包率" Foreground="#5B6472" FontSize="11"
                       TextWrapping="Wrap" Margin="0,12,0,0"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <TextBlock x:Name="LogText" Grid.Row="2" Text="驱动 \\.\LdacCtl   ·   发送端 ldac-send.exe --loopback --match LDAC" Foreground="#5B6472" FontSize="11"
               Margin="0,14,0,0" TextTrimming="CharacterEllipsis"/>
  </Grid>
</Window>
